# env.conf — systemd override для передачи API-ключей в openclaw-gateway
#
# Почему нужен этот файл:
#   systemd НЕ читает .env автоматически. openclaw.json использует ${VAR}
#   плейсхолдеры, но если substitution не прошёл при deploy — ключи будут
#   пусты. Этот override гарантирует что переменные доступны daemon'у.
#
# Установка на VPS:
#   mkdir -p ~/.config/systemd/user/openclaw-gateway.service.d/
#   cp env.conf.example ~/.config/systemd/user/openclaw-gateway.service.d/env.conf
#   # Заполни реальными ключами из .env
#   nano ~/.config/systemd/user/openclaw-gateway.service.d/env.conf
#   systemctl --user daemon-reload && systemctl --user restart openclaw-gateway
#
# НЕ коммитить с реальными ключами! Только этот .example файл.

[Service]
Environment="GROQ_API_KEY=YOUR_GROQ_API_KEY"
Environment="OPENAI_API_KEY=YOUR_OPENAI_API_KEY"
Environment="DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY"
Environment="OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY"
Environment="MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY"
Environment="TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN"
Environment="TELEGRAM_USER_ID=YOUR_TELEGRAM_USER_ID"
