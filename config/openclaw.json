{
  "auth": {
    "profiles": {
      "minimax": {
        "endpoint": "https://api.minimax.io/v1",
        "apiKey": "${MINIMAX_API_KEY}"
      },
      "deepseek": {
        "endpoint": "https://api.deepseek.com/v1",
        "apiKey": "${DEEPSEEK_API_KEY}"
      },
      "openrouter": {
        "endpoint": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}"
      },
      "groq": {
        "endpoint": "https://api.groq.com/openai/v1",
        "apiKey": "${GROQ_API_KEY}"
      },
      "openai": {
        "endpoint": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}"
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/clawd/.openclaw/workspace",
      "userTimezone": "Europe/Moscow",
      "timeFormat": "24",
      "contextInjection": "continuation-skip",
      "timeoutSeconds": 180,
      "model": {
        "// PRIMARY: geo-aware. Для RU/EU VPS DeepSeek ближе; для Asia можно переключить на minimax/MiniMax-M2.7": "PENDING-FIXES-v1.8",
        "primary": "deepseek/deepseek-v4-flash",
        "// FALLBACK: не добавляем дорогой auto-fallback для DeepSeek primary": "АУДИТ",
        "fallbacks": []
      },
      "heartbeat": {
        "// Дешёвая модель для 24/7 фоновых проверок": "блок-12",
        "model": "openrouter/google/gemini-2.5-flash-lite",
        "fallbacks": [
          "deepseek/deepseek-v4-flash"
        ],
        "lightContext": true,
        "every": "60m",
        "isolatedSession": true,
        "skipWhenBusy": true,
        "activeHours": {
          "start": "08:00",
          "end": "22:00",
          "timezone": "Europe/Moscow"
        },
        "rateLimit": {
          "perMinute": 1,
          "perHour": 5,
          "perDay": 50
        }
      },
      "subagents": {
        "// Kimi специально создана для sub-agent parallelism": "блок-03",
        "model": "openrouter/moonshotai/kimi-k2.6",
        "fallbacks": [
          "deepseek/deepseek-v4-flash"
        ]
      },
      "compaction": {
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000,
          "reserveTokensFloor": 20000,
          "model": "deepseek/deepseek-v4-flash",
          "systemPrompt": "Сохрани durable факты в memory/YYYY-MM-DD.md. Если ничего важного — ответь NO_REPLY."
        }
      }
    }
  },
  "models": {
    "providers": {
      "gonka": {
        "baseUrl": "https://gonka-gateway.mingles.ai/v1",
        "apiKey": "${GONKA_API_KEY}",
        "auth": "api-key",
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "Qwen/Qwen3-235B-A22B-Instruct-2507-FP8",
            "name": "Qwen3-235B",
            "api": "openai-completions",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0
            },
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "moonshotai/Kimi-K2.6",
            "name": "moonshotai/Kimi-K2.6",
            "api": "openai-completions",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0
            },
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      },
      "minimax": {
        "timeoutSeconds": 120
      }
    }
  },
  "channels": {
    "telegram": {
      "accounts": {
        "main": {
          "tokenFile": "~/.openclaw/secrets/telegram.token",
          "// dmPolicy allowlist + числовой user ID = только владелец пишет в DM": "блок-04",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "${TELEGRAM_USER_ID}"
          ],
          "groupPolicy": "manual",
          "pollingStallThresholdMs": 30000,
          "mediaMaxMb": 50,
          "transcribeVoiceMessages": true,
          "audioMaxDurationSec": 300,
          "voiceReplies": "auto"
        }
      }
    }
  },
  "tools": {
    "profile": "full",
    "media": {
      "audio": {
        "models": [
          {
            "provider": "groq"
          }
        ]
      }
    }
  },
  "memory": {},
  "mcp": {
    "servers": {
      "tavily": {
        "command": "npx",
        "args": [
          "-y",
          "tavily-mcp"
        ],
        "env": {
          "TAVILY_API_KEY": "${TAVILY_API_KEY}"
        }
      },
      "playwright": {
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest"
        ]
      }
    }
  },
  "skills": {
    "entries": {}
  },
  "plugins": {
    "allow": [
      "telegram",
      "minimax",
      "deepseek",
      "openrouter",
      "groq",
      "openai",
      "device-pair",
      "memory-core",
      "gonka",
      "openclaw-mem0"
    ],
    "entries": {
      "telegram": {
        "enabled": true
      },
      "minimax": {
        "enabled": true
      },
      "deepseek": {
        "enabled": true
      },
      "openrouter": {
        "enabled": true
      },
      "groq": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "device-pair": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true
      },
      "gonka": {
        "enabled": true
      },
      "openclaw-mem0": {
        "enabled": true,
        "config": {
          "mode": "open-source",
          "userId": "clawd",
          "apiKey": "",
          "oss": {
            "llm": {
              "provider": "openai",
              "config": {
                "model": "openrouter/moonshotai/kimi-k2.6",
                "apiKey": "${OPENAI_API_KEY}"
              }
            },
            "embedder": {
              "provider": "ollama",
              "config": {
                "model": "nomic-embed-text",
                "ollamaUrl": "http://localhost:11434",
                "embeddingDims": 768
              }
            },
            "vectorStore": {
              "provider": "qdrant",
              "config": {
                "url": "http://localhost:6333",
                "onDisk": true,
                "dimension": 768,
                "embeddingModelDims": 768,
                "collectionName": "mem0_768d"
              }
            }
          },
          "skills": {
            "triage": {
              "enabled": true
            },
            "recall": {
              "enabled": true,
              "tokenBudget": 1500,
              "rerank": true,
              "keywordSearch": true,
              "identityAlwaysInclude": true
            },
            "dream": {
              "enabled": true
            },
            "domain": "companion"
          }
        }
      }
    }
  },
  "ui": {
    "// Control UI на 127.0.0.1 — не 0.0.0.0! Удалённый доступ через SSH-туннель": "блок-13",
    "enabled": true,
    "host": "127.0.0.1",
    "port": 4000,
    "auth": {
      "type": "token",
      "tokenFile": "~/.openclaw/secrets/ui.token"
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_AUTH_TOKEN}"
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": {
          "enabled": true
        }
      }
    }
  },
  "commands": {
    "debug": true
  },
  "logging": {
    "level": "info",
    "redactSensitive": true,
    "redactPatterns": [
      "sk-[A-Za-z0-9]+",
      "Bearer\\s+[A-Za-z0-9]+",
      "ghp_[A-Za-z0-9]+"
    ],
    "rotate": {
      "maxSizeMb": 100,
      "maxFiles": 7
    }
  }
}