{
  "agents": {
    "defaults": {
      "workspace": "/home/clawd/.openclaw/workspace",
      "models": {
        "minimax/MiniMax-M2.7": {
          "alias": "Minimax"
        },
        "deepseek/deepseek-v4-flash": {},
        "deepseek/deepseek-v4-pro": {
          "alias": "premium"
        },
        "deepseek/deepseek-v4-pro:thinking": {
          "alias": "think"
        },
        "gonka/Qwen/Qwen3-235B-A22B-Instruct-2507-FP8": {
          "alias": "qwen235b"
        },
        "gonka/moonshotai/Kimi-K2.6": {
          "alias": "kimi26"
        }
      },
      "model": {
        "primary": "openai/gpt-5",
        "fallbacks": [
          "minimax/MiniMax-M2.7",
          "deepseek/deepseek-v4-flash",
          "gonka/Qwen/Qwen3-235B-A22B-Instruct-2507-FP8"
        ]
      },
      "timeoutSeconds": 180,
      "imageGenerationModel": {
        "primary": "openrouter/google/gemini-2.5-flash-image",
        "fallbacks": [
          "openrouter/black-forest-labs/flux-schnell"
        ]
      },
      "heartbeat": {
        "model": "openrouter/google/gemini-2.5-flash-lite"
      },
      "contextInjection": "continuation-skip",
      "compaction": {
        "keepRecentTokens": 40000,
        "maxHistoryShare": 0.5,
        "memoryFlush": {
          "enabled": true,
          "model": "openrouter/moonshotai/kimi-k2.6"
        }
      },
      "contextPruning": {
        "mode": "cache-ttl"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_AUTH_TOKEN}"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "env": {
    "GROQ_API_KEY": "${GROQ_API_KEY}",
    "OPENAI_SOCKS_PROXY": "${OPENAI_SOCKS_PROXY}",
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
