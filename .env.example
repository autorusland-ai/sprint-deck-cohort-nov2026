# =============================================================================
# Comandos Claw Deck — переменные окружения
# =============================================================================
# Скопируй: cp .env.example .env
# Заполни ключи. .env уже в .gitignore — НЕ коммитится.
# =============================================================================


# ===== МОДЕЛИ (4 ключа — обязательные) ===========================================

# 1. MiniMax — PRIMARY модель (через Coding Plan $10/мес фикс)
# Где: platform.minimax.io → Subscribe → Coding Plan Starter
MINIMAX_API_KEY=

# 2. DeepSeek — FALLBACK + PREMIUM (V4-Flash и V4-Pro)
# Где: api-docs.deepseek.com → Sign up → API key, закинь $10
DEEPSEEK_API_KEY=

# 3. OpenRouter — HEARTBEAT (Gemini Flash-Lite) + SUBAGENTS (Kimi K2.6)
# Где: openrouter.ai → Settings → API key, закинь $10
# КРИТИЧНО: в Settings включи Spending Limit $30/мес — это provider hard limit
OPENROUTER_API_KEY=

# 4. Groq — Whisper транскрипция голосовых (БЕСПЛАТНО, 30k минут/мес)
# Где: console.groq.com → API keys
GROQ_API_KEY=


# ===== TELEGRAM (2 значения — обязательные) =====================================

# Bot token через @BotFather → /newbot → название → username @xxx_bot → token
TELEGRAM_BOT_TOKEN=

# Свой числовой User ID (НЕ username) через @userinfobot
# Это нужно для dmPolicy: allowlist — только ты сможешь писать в DM
TELEGRAM_USER_ID=


# ===== VOICE (опционально) ======================================================

# OpenAI TTS — голосовые ответы (~$1-2/мес, tts-1, не tts-1-hd)
# Где: platform.openai.com → API keys
OPENAI_API_KEY=

# ElevenLabs — альтернатива TTS лучшего качества ($5/мес Starter)
# Где: elevenlabs.io
ELEVENLABS_API_KEY=


# ===== MCP-СЕРВЕРЫ (опционально) ================================================

# Tavily — продвинутый AI-поиск (есть free tier)
# Где: tavily.com → API key
TAVILY_API_KEY=

# Notion API — если будешь подключать MCP
# Где: notion.so/my-integrations
NOTION_API_KEY=

# GitHub PAT — если будешь подключать GitHub MCP
# Где: github.com/settings/tokens → Generate new token (classic)
# Scopes: repo, read:user
GITHUB_PAT=


# ===== ВОРКШОП 3: веб-инструменты, браузер, Google, Tor =========================

# Brave Search API — основной web_search (free 2000 запросов/мес)
# Где: brave.com/search/api → Subscribe (Free tier) → API key
BRAVE_API_KEY=

# Google Cloud OAuth — Gmail + Calendar MCP (google-workspace)
# Где: console.cloud.google.com → проект → APIs&Services → Credentials →
#      OAuth client ID (тип Desktop). Scopes: gmail.readonly, gmail.send,
#      calendar (для записи событий — НЕ readonly).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Те же значения для google-workspace MCP (обычно совпадают с OAUTH-парой выше).
# REFRESH_TOKEN получается при первом OAuth-флоу (см. disaster-recovery.md, раздел W3).
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=

# Tor SOCKS5 — обход геоблокировки OpenAI (VPS в РФ → OpenAI отдаёт 403).
# Поднимается на VPS через `apt install tor` (см. bootstrap-vps.sh, этап W3).
# Значение по умолчанию: socks5://127.0.0.1:9050
OPENAI_SOCKS_PROXY=socks5://127.0.0.1:9050


# ===== GATEWAY / прочее =========================================================

# Токен авторизации OpenClaw gateway. Если пусто — bootstrap сгенерирует
# новый: `openssl rand -hex 24`.
GATEWAY_AUTH_TOKEN=

# Gonka — провайдер (опц., если используешь gonka provider в models)
GONKA_API_KEY=


# ===== VPS =====================================================================

# IP твоего VPS (от хостера на email)
VPS_IP=

# Root-пароль VPS (от хостера на email)
# Нужен ТОЛЬКО на Промпте 3 (загрузка SSH-ключа на VPS).
# После Промпта 4 (hardening) root SSH-логин блокируется → пароль больше не нужен,
# но оставь его в .env пока не закончишь Воркшоп 1 на случай восстановления.
ROOT_PASSWORD=

# Пользователь на VPS
# ⚠️ ИЗНАЧАЛЬНО: root (так VPS приходит от хостера)
# ПОСЛЕ ПРОМПТА 4 (hardening): AI должен ОБНОВИТЬ это значение на clawd
# (создаёт пользователя clawd с passwordless sudo, блокирует root SSH)
VPS_USER=root

# Путь к приватному SSH-ключу (создаётся в Промпте 2)
SSH_KEY_PATH=~/.ssh/clawd_ed25519

# SSH alias из ~/.ssh/config (опционально, для удобства подключения)
SSH_ALIAS=clawd-vps


# ===== РЕЖИМ DEBUG (опц.) =======================================================

OPENCLAW_DEBUG=0
